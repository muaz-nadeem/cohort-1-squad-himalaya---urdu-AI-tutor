# Uplift AI
UPLIFT_API_KEY=sk_api_your_key_here

# After running `npm run setup`, paste the assistant ID here
UPLIFT_ASSISTANT_ID=

# Server
PORT=3001

# Comma-separated browser origins allowed to call this server (no trailing slash)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth — require one of these for /api/session and /api/rag/search
# Prefer Supabase JWT (same secret as FastAPI SUPABASE_JWT_SECRET):
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
# Or a shared secret sent as header X-Realtime-Secret:
# REALTIME_SERVER_SECRET=long-random-string

# RAG API (your team's retrieval endpoint — update when ready)
RAG_API_URL=http://localhost:8000/api/rag/ask
