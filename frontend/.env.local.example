# Base URL of the FastAPI backend (no trailing slash)
# Local:
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production (set in Vercel → Project → Settings → Environment Variables):
# NEXT_PUBLIC_API_URL=https://xxxxx.region.awsapprunner.com

# Public frontend origin used as a fallback for email-confirmation redirects
# (signup already prefers window.location.origin). Also add this URL in
# Supabase → Authentication → URL Configuration → Site URL + Redirect URLs.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Supabase Auth (anon key is safe for the browser; never put the service role here)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
