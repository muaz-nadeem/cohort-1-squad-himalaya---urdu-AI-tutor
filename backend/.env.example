# ── Groq (LLM + Whisper STT + Vision for tutor/RAG) ──
GROQ_API_KEY=your_groq_api_key
# Optional: override the default LLM / vision models (tutor + textbook RAG)
# GROQ_LLM_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=qwen/qwen3.6-27b

# ── OpenAI (MCQ PDF ingestion only — cheapest model) ──
OPENAI_API_KEY=your_openai_api_key

# ── Gemini (MCQ PDF ingestion only) ──
GEMINI_API_KEY=your_gemini_api_key
# Optional: override the default Gemini models for MCQ ingest
# GEMINI_MCQ_TEXT_MODEL=gemini-2.0-flash
# GEMINI_MCQ_VISION_MODEL=gemini-2.0-flash

# ── Uplift AI (Orator TTS + STT — CURRENTLY ACTIVE) ──
UPLIFT_API_KEY=your_uplift_key
UPLIFT_VOICE_ID=v_8eelc901

# ── ElevenLabs (TTS — inactive; code path commented out, needs paid plan) ──
# ELEVENLABS_API_KEY=your_elevenlabs_key
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Supabase (Postgres + pgvector) ──
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_service_or_anon_key

# ── Server ──
PORT=8000
# Comma-separated list of allowed origins for CORS (frontend URL)
CORS_ORIGINS=http://localhost:3000
