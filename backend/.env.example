# ── Groq (LLM + Whisper STT + Vision for tutor/RAG) ──
GROQ_API_KEY=your_groq_api_key
# Optional: override the default LLM / vision models (tutor + textbook RAG)
# GROQ_LLM_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=qwen/qwen3.6-27b

# ── OpenAI (MCQ PDF ingestion only — cheapest model) ──
OPENAI_API_KEY=your_openai_api_key

# ── Gemini (MCQ PDF ingestion only) ──
GEMINI_API_KEY=your_gemini_api_key
# Optional: override the default Gemini models for MCQ ingest
# GEMINI_MCQ_TEXT_MODEL=gemini-2.0-flash
# GEMINI_MCQ_VISION_MODEL=gemini-2.0-flash

# ── Uplift AI (Orator TTS + STT — CURRENTLY ACTIVE) ──
UPLIFT_API_KEY=your_uplift_key
UPLIFT_VOICE_ID=v_8eelc901

# ── ElevenLabs (TTS — inactive; code path commented out, needs paid plan) ──
# ELEVENLABS_API_KEY=your_elevenlabs_key
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Supabase (Postgres + pgvector + Auth) ──
SUPABASE_URL=your_supabase_url
# Server-only service role key (bypasses RLS). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Legacy alias still accepted if SERVICE_ROLE is unset:
# SUPABASE_KEY=your_supabase_service_role_key
# JWT Secret from Supabase → Project Settings → API (used to verify Bearer tokens)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ── Server / deployment ──
PORT=8000
# development | production  (Docker image defaults to production)
ENVIRONMENT=development

# Comma-separated frontend origins for CORS (no trailing slash). Never use * in production.
# Local:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production example (set in App Runner / ECS env):
# CORS_ORIGINS=https://your-app.vercel.app,https://uraan.app

# Optional host allow-list (TrustedHostMiddleware). Leave empty locally.
# TRUSTED_HOSTS=api.uraan.app,*.awsapprunner.com

# Max mic clip size for /api/ask-voice and /api/rag/ask-voice
# MAX_AUDIO_UPLOAD_MB=10

# Skip embedding model load on boot (faster cold start; first RAG request is slower)
# SKIP_EMBED_WARMUP=false
